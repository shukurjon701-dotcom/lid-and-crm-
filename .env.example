# PostgreSQL — обязательна: без базы приложение показывает ошибку,
# а не выдуманные цифры
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lid_crm?schema=public"

# Секрет для подписи JWT-сессии (openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# Валюта и локаль отчётов
NEXT_PUBLIC_CURRENCY="UZS"
NEXT_PUBLIC_LOCALE="ru-RU"

# Виртуальная АТС onlinePBX (звонки call-центра)
PBX_DOMAIN="pbxXXXXX.onpbx.ru"
PBX_API_KEY=""
